# Local development only. Replace this password before starting Compose.
POSTGRES_DB=taibifer
POSTGRES_USER=taibifer
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
API_PORT=8000
ADMINER_PORT=8080

# Set only in the ignored .env. Never paste a real key here.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2

# Answer generation; separate from the embedding model.
CHAT_MODEL=gpt-6-luna
CHAT_TOKENIZER=o200k_base
CHAT_MAX_INPUT_TOKENS=8000
CHAT_MAX_OUTPUT_TOKENS=1500
CHAT_CONTEXT_WINDOW=1050000
CHAT_FRAMING_TOKEN_RESERVE=256
CHAT_TIMEOUT_SECONDS=60
CHAT_MAX_RETRIES=2
CHAT_REASONING_EFFORT=none
