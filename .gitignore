# Local secrets; keep the shareable configuration template.
.env
.env.*
!.env.example

# Python environments, caches, and package build output.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local editor settings and operating-system files.
.idea/
.vscode/
.DS_Store
._*
*.swp
*.swo

# Private knowledge, manifests, and evaluation material stay local.
/.local/
/knowledge/raw/
/evaluation/private/

# Local walkthrough notes and development documentation.
/docs/
